# Builda o binário contra a baseline de glibc mais antiga onde o Tauri v2/GTK3 é viável no
# Linux: Ubuntu 22.04 (glibc 2.35) é a release mais antiga que já empacota
# webkit2gtk-4.1-dev/libsoup3 -- distros mais antigas (Ubuntu 20.04, Debian 11) nem têm esse
# pacote pra compilar contra. Na prática, GLIBC_2.34 é o piso real do Tauri v2/GTK3 (libs do
# próprio sistema, como libgmodule-2.0, já exigem essa versão): em sistemas mais antigos, ou
# sem webkit2gtk-4.1 instalado, o shell `tauri` não abre -- use `--shell=puppeteer` ou
# `--shell=browser`. Não é um bug, é o limite dessa abordagem.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates build-essential pkg-config \
    libwebkit2gtk-4.1-dev libgtk-3-dev librsvg2-dev libappindicator3-dev patchelf \
    && rm -rf /var/lib/apt/lists/*

# Fora de /root de propósito: essa pasta é 0700 (só o dono acessa), e o build roda como um UID
# arbitrário (--user, ver src/release/build-native.ts, pra não deixar os arquivos gerados
# donos de root no host) -- precisa que qualquer UID consiga ler e executar o toolchain.
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH="/usr/local/cargo/bin:${PATH}"

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal \
    && chmod -R a+rX /usr/local/rustup /usr/local/cargo

WORKDIR /work
