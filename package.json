{
  "name": "api-fake",
  "private": true,
  "version": "1.3.0-rc.4",
  "type": "module",
  "types": "./src/types/index.ts",
  "exports": {
    ".": {
      "types": "./src/types/index.ts",
      "import": "./src/types/index.ts"
    },
    "./eslint-config": {
      "import": "./src/shared/eslint-config.ts"
    },
    "./tsconfig-base.json": "./config/tsconfig-base.json",
    "./prettier-config.json": "./.prettierrc"
  },
  "scripts": {
    "----CLIENTE--------": "------------------------------------------------------------------------",
    "client:dev:wait": "wait-on tcp:3342 && vite",
    "----SERVER---------": "------------------------------------------------------------------------",
    "server:dev": "tsx ./src/app/backend/server.ts",
    "server:dev:watch": "tsx --watch ./src/app/backend/server.ts",
    "----PUPPETEER------": "------------------------------------------------------------------------",
    "puppeteer:dev": "wait-on tcp:3343 && NODE_ENV=development tsx ./src/app/frontend/shells/puppeteer/main.ts",
    "----ELECTRON-------": "------------------------------------------------------------------------",
    "electron:dev": "wait-on tcp:3343 && NODE_ENV=development electron --ozone-platform=x11 --disable-gpu dist/electron/main.js",
    "----TUI-------------": "------------------------------------------------------------------------",
    "tui:dev": "wait-on tcp:3342 && NODE_ENV=development tsx --tsconfig tsconfig.pack-tui.json ./src/app/frontend/tui/main.tsx",
    "----DEV-SCRIPTS----": "------------------------------------------------------------------------",
    "postinstall": "tsx src/tooling/postinstall/download-puppeteer.ts",
    "dev:with:puppeteer": "concurrently --handle-input --default-input-target 0 --names \"BACKEND,FRONTEND,PUPPETEER\" --prefix-colors \"blue,green,cyan\" --kill-others \"npm:server:dev:watch\" \"npm:client:dev:wait\" \"npm:puppeteer:dev\"",
    "dev:with:electron": "concurrently --handle-input --default-input-target 0 --names \"BACKEND,FRONTEND,ELECTRON\" --prefix-colors \"blue,green,cyan\" --kill-others \"npm:server:dev:watch\" \"npm:client:dev:wait\" \"npm:electron:dev\"",
    "dev:with:tui": "node scripts/dev-tui.mjs",
    "dev:browser": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"blue,green\" --kill-others-on-fail \"npm:server:dev:watch\" \"npm:client:dev:wait\"",
    "lint": "eslint .",
    "prettier:check": "prettier --check .",
    "prettier": "prettier --write .",
    "----BUILD----------": "------------------------------------------------------------------------",
    "build:types": "tsup src/types/index.ts --dts-only --format esm --out-dir dist/types --tsconfig tsconfig.pack-types.json",
    "build:server": "tsup src/app/backend/server.ts --format esm --dts --out-dir dist/server --tsconfig tsconfig.pack-server.json",
    "build:client": "vite build",
    "build:puppeteer": "tsup src/app/frontend/shells/puppeteer/main.ts --format esm --out-dir dist/puppeteer --tsconfig tsconfig.pack-puppeteer.json --external puppeteer --clean",
    "build:bin": "tsx src/release/build-bin.ts",
    "build:postinstall": "tsx src/release/build-postinstall.ts",
    "build:electron": "tsup src/app/frontend/shells/electron/main.ts --format esm --out-dir dist/electron --tsconfig tsconfig.pack-electron.json",
    "build:tui": "tsup src/app/frontend/tui/main.tsx --format esm --out-dir dist/tui --tsconfig tsconfig.pack-tui.json --clean",
    "build:shared-config": "tsup src/shared/eslint-config.ts --format esm --out-dir dist/shared --tsconfig tsconfig.pack-shared-config.json --external eslint --external typescript-eslint --external eslint-plugin-simple-import-sort",
    "build": "npm run build:types && npm run build:server && npm run build:client && npm run build:puppeteer && npm run build:tui && npm run build:bin && npm run build:postinstall && npm run build:shared-config",
    "----PACKAGE--------": "------------------------------------------------------------------------",
    "package:prepare": "tsx src/release/prepare-release-package.ts",
    "package:pack": "tsx src/release/release.ts"
  },
  "dependencies": {
    "@types/express": "^5.0.1",
    "axios": "^1.7.8",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "eslint": "^9.15.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "express": "^4.21.2",
    "ink": "^5.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "prettier": "^3.9.6",
    "puppeteer": "^24.43.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remove": "^0.1.5",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "wait-on": "^9.0.3",
    "wrap-ansi": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/wait-on": "^5.3.4",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "electron": "^42.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "vite": "^6.0.1"
  },
  "engines": {
    "node": "^22"
  }
}
